# Special Learns Institute — Environment Configuration
# Copy to .env and fill in your values. Never commit .env.

# Port the enquiry API listens on
PORT=3000

# Where validated enquiries are appended locally as newline-delimited JSON backup.
ENQUIRY_FILE=./server/data/enquiries.ndjson

# ---------------------------------------------------------------------
# Supabase Database / Storage Configuration
# ---------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
# 1. Project URL:
SUPABASE_URL=https://your-project.supabase.co

# 2. Project API Key (Use 'service_role' secret key for backend, or 'anon' public key):
SUPABASE_KEY=your-supabase-key-here

# ---------------------------------------------------------------------
# Email Notifications on New Student Enrolment
# ---------------------------------------------------------------------
# Delivered via Resend (https://resend.com)
#
# 1. Your Resend API Key:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# 2. Email where enrolment alerts should be sent (comma-separated for multiple):
MAIL_TO=info@speciallearns.in

# 3. Sender address (leave blank for onboarding@resend.dev, or use verified domain):
MAIL_FROM=Special Learns <admissions@speciallearns.in>
