{
  "name": "special-learns-institute",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketing website for Special Learns Institute — computer training and tuition classes, New Delhi.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "npm run sitemap && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.mjs",
    "enquiries": "node scripts/enquiries.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.445.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "puppeteer-core": "^25.14.0",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18.18"
  }
}
