# Copy to .env and adjust. Never commit real secrets.
# The frontend does NOT read any of these — only the Node API does.

# Port the enquiry API listens on (the Vite dev server proxies /api here).
PORT=8787

# Where validated enquiries are appended as newline-delimited JSON.
# Point this at persistent storage in production.
ENQUIRY_FILE=./server/data/enquiries.ndjson

# ---------------------------------------------------------------------
# Email delivery (optional)
# ---------------------------------------------------------------------
# Leave these blank and enquiries are still stored AND printed to the
# terminal running the server — nothing is lost, but nobody is notified.
#
# Set both to have every enquiry emailed to MAIL_TO as well:
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#   MAIL_TO=admissions@speciallearns.in
RESEND_API_KEY=

# Where enquiries are sent. Must be a verified sender or recipient in Resend.
MAIL_TO=

# The From: address. Defaults to Resend's onboarding address, which only
# delivers to your own account — set a verified domain for real use.
MAIL_FROM=
